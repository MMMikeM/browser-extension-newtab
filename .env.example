# Turso database (embedded replica — local SQLite synced to Turso)
# Local file is local.db, syncUrl points to Turso upstream
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Auth token for client → server requests
AUTH_TOKEN=your-secret-token

# Server URL (used by extension to reach server functions)
SERVER_URL=http://localhost:3000
